@model MvcCreditApp1.Models.Bid

@{
    ViewBag.Title = "Удаление заявки";
}

<h2>Удаление заявки</h2>

<h3>Вы уверены, что хотите удалить эту заявку?</h3>
<div>
    <fieldset>
        <legend>Заявка</legend>
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CreditHead)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.CreditHead)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.bidDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.bidDate)
            </dd>
        </dl>
    </fieldset>

    <form asp-action="Delete">
        <input type="hidden" asp-for="BidId" />
        <input type="submit" value="Удалить" /> |
        @Html.ActionLink("Вернуться в список", "Index")
    </form>
</div>
