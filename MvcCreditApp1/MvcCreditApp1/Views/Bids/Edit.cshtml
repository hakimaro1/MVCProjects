@model MvcCreditApp1.Models.Bid

@{
    ViewBag.Title = "Изменение заявки";
}

<h2>Изменение заявки</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BidId" />
            <fieldset>
                <legend>Заявка</legend>
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CreditHead" class="control-label"></label>
                    <input asp-for="CreditHead" class="form-control" />
                    <span asp-validation-for="CreditHead" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="bidDate" class="control-label"></label>
                    <input asp-for="bidDate" class="form-control" />
                    <span asp-validation-for="bidDate" class="text-danger"></span>
                </div>
                <p>
                    <input type="submit" value="Сохранить" />
                </p>
            </fieldset>
        </form>
    </div>
</div>

<div>
    @Html.ActionLink("Вернуться в список", "Index")
</div>
